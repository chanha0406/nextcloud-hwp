<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>hwp_viewer</id>
	<name>HWP Viewer</name>
	<summary>View and edit HWP and HWPX documents in the Nextcloud Viewer</summary>
	<description><![CDATA[
Read/write Hangul Word Processor (.hwp / .hwpx) files inside the Nextcloud Viewer.
Uses a self-hosted rhwp-studio build via @rhwp/editor (WASM), with Save back to WebDAV.
]]></description>
	<version>1.1.0</version>
	<licence>agpl</licence>
	<author mail="dev@localhost">HWP Viewer contributors</author>
	<namespace>HwpViewer</namespace>
	<category>files</category>
	<category>office</category>
	<bugs>https://github.com/</bugs>
	<dependencies>
		<nextcloud min-version="34" max-version="34"/>
	</dependencies>
	<types>
		<filesystem/>
	</types>
	<repair-steps>
		<post-migration>
			<step>OCA\HwpViewer\Migration\RegisterMimeType</step>
		</post-migration>
		<install>
			<step>OCA\HwpViewer\Migration\RegisterMimeType</step>
		</install>
	</repair-steps>
</info>
