<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>hwp_viewer</id>
	<name>HWP Documents</name>
	<summary>Open and edit HWP and HWPX documents in Nextcloud</summary>
	<description><![CDATA[
Open Hangul Word Processor (.hwp / .hwpx) files for reading and editing inside Nextcloud.
Uses a self-hosted rhwp-studio build via @rhwp/editor (WASM), with Save back to WebDAV.
	]]></description>
	<version>1.1.0</version>
	<licence>agpl</licence>
	<author mail="chanha0406@gmail.com" homepage="https://github.com/chanha0406">chanha0406</author>
	<namespace>HwpViewer</namespace>
	<category>files</category>
	<category>office</category>
	<website>https://github.com/chanha0406/nextcloud-hwp</website>
	<bugs>https://github.com/chanha0406/nextcloud-hwp/issues</bugs>
	<repository type="git">https://github.com/chanha0406/nextcloud-hwp.git</repository>
	<dependencies>
		<nextcloud min-version="34" max-version="34"/>
	</dependencies>
	<types>
		<filesystem/>
	</types>
	<repair-steps>
		<post-migration>
			<step>OCA\HwpViewer\Migration\RegisterMimeType</step>
		</post-migration>
		<install>
			<step>OCA\HwpViewer\Migration\RegisterMimeType</step>
		</install>
	</repair-steps>
</info>
