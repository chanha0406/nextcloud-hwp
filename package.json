{
  "name": "hwp_viewer",
  "version": "1.1.0",
  "private": true,
  "description": "View and edit HWP and HWPX documents in the Nextcloud Viewer",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
